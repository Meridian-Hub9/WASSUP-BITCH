    powerBox.Visible = not minimized
    minBtn.Text = minimized and "+" or "−"

    TweenService:Create(main, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = minimized and minimizedSize or expandedSize
