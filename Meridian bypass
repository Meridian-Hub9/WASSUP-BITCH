-- ==========================================
-- BYPASS LOGIC (From Nxtzy)
-- ==========================================
local activated = false
local keybind = Enum.KeyCode.V
local waitingForKey = false
local power = 23500
local lagAmount = 0.12
local lagConn = nil

local function applyPower(val)
    power = math.clamp(val, 10000, 500000)
    local t = (power - 10000) / 490000
    lagAmount = t * 0.2
end

local function startLag()
    if lagConn then lagConn:Disconnect() end
    lagConn = RunService.RenderStepped:Connect(function()
        if not activated then return end
        if lagAmount > 0 then
            local t = tick()
            while tick() - t < lagAmount do end
        end
    end)
end

local function stopLag()
    activated = false
    if lagConn then
        lagConn:Disconnect()
        lagConn = nil
    end
end

-- ==========================================
-- POWER SAVING LOGIC
-- ==========================================
local function loadPower()
    local defaultPower = 23500
    if isfile and readfile then
        local success, content = pcall(function()
            if isfile("MeridianBypass_Power.txt") then
                return readfile("MeridianBypass_Power.txt")
            end
            return nil
        end)
        if success and content then
            local val = tonumber(content)
            if val then
                return math.clamp(val, 10000, 500000)
            end
        end
    end
    return defaultPower
end

local function savePower(val)
    if writefile then
        pcall(function()
            writefile("MeridianBypass_Power.txt", tostring(val))
        end)
    end
end

power = loadPower()
applyPower(power)
